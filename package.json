{
  "name": "dsh-quota-center",
  "description": "DSH 统一额度中心：ChatGPT 订阅额度、DeepSeek 余额和 OpenCode Go 配额",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "node scripts/test-page-script.mjs && node --test scripts/test-center.mjs",
    "check": "npm run build && npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5",
    "@deepseek-ai/dsh-client-connection": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-cordis-client-runner": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.2",
    "react": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-cordis-client-runner": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-cordis-client-runner"
      ],
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "quota",
    "balance",
    "usage",
    "opencode"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackGuo0310/dsh-quota-center.git"
  }
}
